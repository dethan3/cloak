# Optional. When set, the NEAR AI run calls https://cloud-api.near.ai/v1
# and requests an attestation report before the scouts.
NEAR_AI_KEY=

# Optional model id. When empty, Cloak asks /v1/models and prefers a known NEAR model.
NEAR_AI_MODEL=

# Override only if you are pointing at a compatible gateway.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Parent account for scout sub-accounts. Testnet. Does not need to exist for the demo.
CLOAK_PARENT_ACCOUNT=cloak-swarm.testnet

# Used for a best-effort view_account lookup. Failure does not stop the run.
NEAR_RPC_URL=https://rpc.testnet.near.org
